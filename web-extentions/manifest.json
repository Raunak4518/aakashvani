{
  "manifest_version": 3,
  "name": "Audio Stream Extension",
  "version": "1.0.0",
  "description": "Streams audio to backend via WebRTC",
  "permissions": [
    "tabCapture",
    "notifications",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*/*"
  ]
}